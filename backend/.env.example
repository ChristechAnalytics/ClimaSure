# Copy to .env and change every value marked CHANGE before deploying.

# SQLite file for local use. Production: Postgres.
CLIMASURE_DB_PATH=climasure.db

# synthetic = offline demo data (never settle real contracts with it)
# open-meteo = real reanalysis + recent analysis data
CLIMASURE_WEATHER_PROVIDER=synthetic
# synthetic only: normal | wet | drought
CLIMASURE_SYNTHETIC_SCENARIO=normal
# Required for commercial use of Open-Meteo
CLIMASURE_OPEN_METEO_API_KEY=

# CHANGE: used to create client accounts via /v1/admin/*
CLIMASURE_ADMIN_API_KEY=dev-admin-key-change-me

CLIMASURE_WEBHOOK_TIMEOUT_S=5
# Grid cell size in degrees (0.05 ~ 5.5 km)
CLIMASURE_GRID_RESOLUTION_DEG=0.05
